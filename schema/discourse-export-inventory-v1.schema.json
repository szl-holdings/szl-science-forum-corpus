{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared local Discourse export inventory; not access or reuse authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site", "scope", "collected_at", "topics"],
  "properties": {
    "schema": {"const": "szl-discourse-export-inventory-v1"},
    "site": {"const": "https://ai4science.discourse.group"},
    "scope": {"const": "declared_topic_set"},
    "collected_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "topics": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["topic_id", "category_id", "file_sha256", "post_ids"],
        "properties": {
          "topic_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
          "category_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
          "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "post_ids": {
            "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
          }
        }
      }
    }
  }
}
