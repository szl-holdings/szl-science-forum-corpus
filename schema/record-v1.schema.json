{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/szl-holdings/szl-science-forum-corpus/blob/main/schema/record-v1.schema.json",
  "title": "SZL Science Forum Source Index Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "source_url", "topic_id", "post_number", "access",
    "publication_rights", "rights_evidence", "public_projection_approved",
    "title", "summary", "need_ids", "review_state", "attribution", "observed_at", "posted_at"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^ai4science:[1-9][0-9]*:[1-9][0-9]*$"},
    "source_url": {"type": "string", "format": "uri", "maxLength": 500},
    "topic_id": {"type": "integer", "minimum": 1},
    "post_number": {"type": "integer", "minimum": 1},
    "access": {"enum": ["public_web", "members_only"]},
    "publication_rights": {"enum": ["operator_authorized", "licensed", "unknown"]},
    "rights_evidence": {"type": "string", "minLength": 1, "maxLength": 500},
    "public_projection_approved": {"type": "boolean"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "need_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "review_state": {"enum": ["unreviewed", "operator_labeled", "double_reviewed"]},
    "attribution": {"type": "string", "minLength": 1, "maxLength": 120},
    "observed_at": {"type": "string", "format": "date"},
    "posted_at": {"type": ["string", "null"], "format": "date"}
  },
  "description": "Reviewed source metadata and independently authored summary only. Attribution remains in the private review input and is omitted from public rows. Raw forum bodies, email addresses, attachments, credentials, and private messages are outside this schema. The Python validator additionally enforces topic and exact reply URL consistency, contact/credential checks, and publication gates."
}
