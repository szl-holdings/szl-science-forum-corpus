{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared research split metadata; no access or training authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "input_kind", "records"],
  "properties": {
    "schema": {"const": "szl-research-splits-v1"},
    "input_kind": {"enum": ["SIMULATED", "SOURCE_METADATA"]},
    "records": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["record_id", "thread_id", "split", "event_time", "author_hashes", "paper_hashes", "duplicate_hashes"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
          "thread_id": {"type": "integer", "minimum": 1, "maximum": 999999999999999999},
          "split": {"enum": ["discovery", "development", "held_out"]},
          "event_time": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
            ]
          },
          "author_hashes": {"$ref": "#/$defs/keys"},
          "paper_hashes": {"$ref": "#/$defs/keys"},
          "duplicate_hashes": {"$ref": "#/$defs/keys"}
        }
      }
    }
  },
  "$defs": {
    "keys": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      ]
    }
  }
}
